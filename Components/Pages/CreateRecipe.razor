@page "/create-recipe"
@rendermode InteractiveServer
@inject DbService DbService;

<PageTitle>Create Recipe</PageTitle>

<div class="generel__animation-fade-in">
    <h1 class="toast-header p-2 generel__font-layout generel__border-layout d-inline-block">
        Create a new recipe!
    </h1>

    <div class="card center-content generel__border-layout">
        <div class="card-body">
            <EditForm Model="@_currentRecipe" OnValidSubmit="CreateNewRecipe">
                <DataAnnotationsValidator/>
                <div class="container text-center generel__border-layout m-2 p-4">
                    <div class="row row-cols-1 row-cols-sd-2 row-cols-md-3 row-cols-lg-3 g-3">
                        <div class="col">
                            <div class="d-flex align-items-center">
                                <label class="form-label mb-0 flex-shrink-0 me-1">Meal Type:</label>
                                <InputText class="form-control" @bind-Value="_currentRecipe.MealType"/>
                            </div>
                        </div>

                        <div class="col">
                            <div class="d-flex align-items-center">
                                <label class="form-label mb-0 flex-shrink-0 me-1">Recipe Name:</label>
                                <InputText class="form-control" @bind-Value="_currentRecipe.Name"/>
                            </div>
                        </div>

                        <div class="col">
                            <label class="generel__file-label"
                                   for="fileInput">@(string.IsNullOrEmpty(_currentRecipe.Base64Image) ? "Choose Image" : "Image Selected")</label>
                            <InputFile id="fileInput" OnChange="ChooseImage" class="d-none"></InputFile>

                            @* Putting the label around the input, achives the same effect as putting it just under it, but
                        now it can be activated by clicking on it *@
                            <label for="use-placeholder-pic">
                                Placeholder?
                                <input type="checkbox" id="use-placeholder-pic" @bind="_usePlaceholderPic"
                                       @onclick="UsePlaceholderPic"/>
                            </label>
                        </div>
                        <div class="col">
                            @if (!_isAddingRecipe)
                            {
                                <button type="submit" class="btn btn-primary col w-100">Create Recipe</button>
                            }
                            else
                            {
                                <Loading LoadingParameter="Recipe"></Loading>
                            }
                        </div>
                    </div>
                </div>
            </EditForm>

            <EditForm Model="@_currentIngredientRecipe" OnSubmit="AddRecipeAsIngredient">
                <div class="container text-center generel__border-layout m-2 p-4">
                    <div class="row row-cols-1 row-cols-sd-3 row-cols-md-3 row-cols-lg-3 align-items-center g-3">
                        <div class="col">
                            <BetterRealTimeRecipesSearch
                                CurrentRecipeDataHasChanged="@(value => _currentIngredientRecipe = value)"/>
                        </div>

                        <div class="col">
                            <div class="d-flex align-items-center">
                                <label class="form-label mb-0 flex-shrink-0 me-1">Parts: 1/</label>
                                <InputNumber class="form-control" @bind-Value="_currentIngredientRecipeParts"/>
                            </div>
                        </div>

                        <div class="col">
                            <div>Current Recipe: @_currentIngredientRecipe.Name</div>
                        </div>

                        <div class="col">
                            <button type="submit" class="btn btn-primary w-100">Add Recipe As
                                Ingredient
                            </button>
                        </div>
                    </div>
                </div>
            </EditForm>

            <EditForm Model="@_currentIngredientGrams" OnSubmit="AddDatabaseIngredient">
                <DataAnnotationsValidator/>
                <div class="container text-center generel__border-layout m-2 p-4">
                    <div class="row row-cols-1 row-cols-sd-3 row-cols-md-3 row-cols-lg-3 g-3">

                        <div class="col">
                            <BetterRealTimeIngredientsSearch
                                CurrentIngredientDataHasChanged="@(value => _crossIngredient = value)"/>
                        </div>

                        <div class="col">
                            <div class="d-flex align-items-center">
                                <label class="form-label mb-0 flex-shrink-0 me-1">Grams</label>
                                <InputNumber class="form-control" @bind-Value="_currentIngredientGrams"/>
                            </div>
                        </div>

                        <div class="col">
                            <p>Current Ingredient: @_crossIngredient.Name</p>
                        </div>

                        <div class="col">
                            <button type="submit" class="btn btn-primary w-100">Add Database Ingredient</button>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="mb-3">
        <AddedIngredients OnIngredientDeleted="AddAllMacrosToRecipe" CurrentAddedIngredients="@_currentIngredients"/>
    </div>

    <div class="mb-3">
        <PreviewRecipe CurrentPreviewRecipe="@_currentRecipe" ViewSideWays="true"/>
    </div>
</div>

<StatusMessageToast @ref="_statusMessageToaster"/>

@code {
    int _currentIngredientGrams;
    int _currentIngredientRecipeParts;
    Recipe _currentRecipe = new();
    Recipe _currentIngredientRecipe = new();
    Ingredient _currentIngredient = new();
    Ingredient _crossIngredient = new();
    StatusMessageToast _statusMessageToaster = null!;
    readonly List<Ingredient> _currentIngredients = new();
    bool _usePlaceholderPic;
    bool _isAddingRecipe;

    private async Task UsePlaceholderPic()
    {
        _usePlaceholderPic = !_usePlaceholderPic;

        try
        {
            if (_usePlaceholderPic)
            {
                string placeholderPath = "wwwroot/pics/PlaceHolderPic.jpg";
                byte[] imageBytes = await File.ReadAllBytesAsync(placeholderPath);
                string base64Image = Convert.ToBase64String(imageBytes);

                _currentRecipe.Base64Image = base64Image;
            }
            else
            {
                _currentRecipe.Base64Image = "";
            }
        }
        catch (FileNotFoundException)
        {
            Console.WriteLine("PlaceHolderPic.jpg was not found");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error setting image: " + ex.Message);
        }
    }

    private async Task CreateNewRecipe()
    {
        Console.WriteLine("Handling recipe...");
        if (_currentIngredients.Count == 0)
        {
            Console.WriteLine("There are no ingredients.");
            await _statusMessageToaster.ShowToastAsync("Recipe was not created; no ingredients added");
            return;
        }

        if (_currentRecipe.MealType is not ("B" or "L" or "D" or "S" or "K"))
        {
            Console.WriteLine($"Invalid meal type \"{_currentRecipe.MealType}\"");
            await _statusMessageToaster.ShowToastAsync($"Recipe was not created; invalid meal type \"{_currentRecipe.MealType}\"");
            return;
        }

        if (string.IsNullOrEmpty(_currentRecipe.Base64Image))
        {
            Console.WriteLine("Image is not set");
            await _statusMessageToaster.ShowToastAsync("Image is not set");
            return;
        }

        _currentRecipe.Ingredients = _currentIngredients;
        _currentRecipe.SetTotalMacros();
        _currentRecipe.SetTotalCost();

        _currentRecipe.PrintRecipe("HandleRecipe");

        _isAddingRecipe = true;
        StateHasChanged();
        try
        {
            string? msg = await DbService.AddRecipeToDb(_currentRecipe);
            if (!string.IsNullOrEmpty(msg))
                await _statusMessageToaster.ShowToastAsync("Error adding recipe to database; " + msg);
            else
                await _statusMessageToaster.ShowToastAsync("Recipe successfully added!");
        }
        catch (Exception ex)
        {
            _isAddingRecipe = false;
            StateHasChanged();
            Console.WriteLine("Error handling recipe: " + ex.Message);
            Console.WriteLine("StackTrace: " + ex.StackTrace);
            return;
        }

        _usePlaceholderPic = false;
        _currentRecipe.ClearRecipe();
        _currentIngredient.ClearIngredient();
        _currentIngredients.Clear();
        
        _isAddingRecipe = false;
        StateHasChanged();
    }

    private async Task ChooseImage(InputFileChangeEventArgs imageFile)
    {
        foreach (var image in imageFile.GetMultipleFiles())
        {
            if (!image.ContentType.Contains("image"))
            {
                Console.WriteLine($"\"{image.ContentType}\" is not allowed");
                await _statusMessageToaster.ShowToastAsync($"\"{image.ContentType}\" is not allowed");
                return;
            }

            try
            {
                await _currentRecipe.SetRecipeImage(image);
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error setting image: " + ex.Message);
                Console.WriteLine(ex.StackTrace);
                return;
            }
        }

        _usePlaceholderPic = false;
    }

    private void AddIngredient()
    {
        Console.WriteLine("Handling ingredient...");
        var tempIngredient = _currentIngredient.TransferIngredient(_currentIngredient);
        tempIngredient.PrintIngredient("HandleIngredient");

        _currentIngredients.Add(tempIngredient);
        AddAllMacrosToRecipe();
        _currentIngredient.ClearIngredient();
    }

    private async Task AddRecipeAsIngredient()
    {
        if (string.IsNullOrEmpty(_currentIngredientRecipe.Name))
        {
            Console.WriteLine("Current ingredient recipe is not selected");
            await _statusMessageToaster.ShowToastAsync("Ingredient recipe is not selected");
            return;
        }

        if (_currentIngredientRecipeParts < 1)
        {
            Console.WriteLine("Parts are below 1");
            await _statusMessageToaster.ShowToastAsync("Parts cant be less than 1");
            return;
        }

        // Just leave this one alone lil bro
        _currentIngredient.Name = _currentIngredientRecipe.Name;
        // ReSharper disable once PossibleLossOfFraction
        _currentIngredient.Grams = 100 / _currentIngredientRecipeParts;
        _currentIngredient.CaloriesPer100g = _currentIngredientRecipe.TotalMacros.Calories;
        _currentIngredient.FatPer100g = _currentIngredientRecipe.TotalMacros.Fat;
        _currentIngredient.CarbsPer100g = _currentIngredientRecipe.TotalMacros.Carbs;
        _currentIngredient.ProteinPer100g = _currentIngredientRecipe.TotalMacros.Protein;
        _currentIngredient.CostPer100g = _currentIngredientRecipe.TotalCost;
        _currentIngredient.IsRecipe = true;

        AddIngredient();
    }

    public async Task AddDatabaseIngredient()
    {
        if (string.IsNullOrEmpty(_crossIngredient.Name))
        {
            Console.WriteLine("No db ingredient selected");
            await _statusMessageToaster.ShowToastAsync("No database ingredient selected");
            return;
        }

        if (_currentIngredientGrams == 0)
        {
            Console.WriteLine("No grams specified.");
            await _statusMessageToaster.ShowToastAsync("No grams selected.");
            return;
        }

        _currentIngredient = _crossIngredient.TransferIngredient(_crossIngredient);
        _currentIngredient.Grams = _currentIngredientGrams;
        AddIngredient();
    }

    private void AddAllMacrosToRecipe()
    {
        _currentRecipe.TotalMacros.Calories = 0;
        _currentRecipe.TotalMacros.Carbs = 0;
        _currentRecipe.TotalMacros.Fat = 0;
        _currentRecipe.TotalMacros.Protein = 0;
        _currentRecipe.TotalCost = 0;

        foreach (var ingredient in _currentIngredients)
        {
            _currentRecipe.TotalMacros.Calories += ingredient.CaloriesPer100g * ingredient.GetMultiplier();
            _currentRecipe.TotalMacros.Carbs += ingredient.CarbsPer100g * ingredient.GetMultiplier();
            _currentRecipe.TotalMacros.Fat += ingredient.FatPer100g * ingredient.GetMultiplier();
            _currentRecipe.TotalMacros.Protein += ingredient.ProteinPer100g * ingredient.GetMultiplier();
            _currentRecipe.TotalCost += ingredient.GetCostPer100g() * ingredient.GetMultiplier();
        }
    }

}